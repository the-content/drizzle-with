{
    "name": "drizzle-with",
    "version": "1.1.0",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/the-content/drizzle-with",
        "directory": "."
    },
    "scripts": {
        "build": "tsdown",
        "test": "vitest",
        "format": "prettier --write ."
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "devDependencies": {
        "@types/bun": "latest",
        "prettier": "^3.6.2",
        "tsdown": "^0.15.7",
        "vitest": "^3.2.4"
    },
    "exports": {
        ".": {
            "import": {
                "default": "./dist/index.js",
                "types": "./dist/index.d.ts"
            },
            "require": {
                "default": "./dist/index.cjs",
                "types": "./dist/index.d.cts"
            }
        },
        "./postgres": {
            "import": {
                "default": "./dist/withs/postgres/index.js",
                "types": "./dist/withs/postgres/index.d.ts"
            },
            "require": {
                "default": "./dist/withs/postgres/index.cjs",
                "types": "./dist/withs/postgres/index.d.cts"
            }
        },
        "./mysql": {
            "import": {
                "default": "./dist/withs/mysql/index.js",
                "types": "./dist/withs/mysql/index.d.ts"
            },
            "require": {
                "default": "./dist/withs/mysql/index.cjs",
                "types": "./dist/withs/mysql/index.d.cts"
            }
        }
    },
    "description": "Query building tool for the Drizzle ORM",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "keywords": [
        "drizzle-orm",
        "drizzle",
        "orm",
        "pagination",
        "sorting",
        "counts",
        "filters",
        "transactions",
        "mysql",
        "postgresql",
        "pg",
        "soft-delete",
        "typescript",
        "query-builder",
        "tanstack-table"
    ],
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false,
    "peerDependencies": {
        "drizzle-orm": "^0.45.0"
    }
}
